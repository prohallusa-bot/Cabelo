rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin email list - UPDATE THIS with your admin emails
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@cabelo.ai' ||
        request.auth.token.email == 'prohallusa@gmail.com'
      );
    }

    // Users collection - admins can read all, users can read/write own
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // User's analyses subcollection
      match /analyses/{analysisId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // User's chats subcollection
      match /chats/{conversationId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && request.auth.uid == userId;

        match /messages/{messageId} {
          allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
          allow write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Hair analyses - public read for sharing, admins can read all
    match /hairAnalysis/{shareId} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can write
    }

    // Blog posts collection
    match /blogPosts/{postId} {
      // Anyone can read published posts, admins can read all
      allow read: if resource.data.published == true || isAdmin();

      // Only admins can create, update, delete
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Photos collection - owners and admins can read
    match /photos/{photoId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // User analysis photos collection - owners and admins can read
    match /userPhotos/{photoId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Legacy chats collection - admins can read all for dashboard
    match /chats/{odcId} {
      allow read: if request.auth != null && (request.auth.uid == odcId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == odcId;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null && (request.auth.uid == odcId || isAdmin());
        allow write: if request.auth != null && request.auth.uid == odcId;
      }
    }

    // Usage tracking - only Cloud Functions can write
    match /usage/{usageId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // Settings collection - admins only
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Notification logs - admins can read, Cloud Functions write
    match /notificationLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // Banned users - admins only
    match /bannedUsers/{bannedId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Legacy analyses collection (keeping for backward compatibility)
    match /analyses/{analysisId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
